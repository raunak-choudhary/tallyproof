  "cards": [
    {
      "dot": "violet",
      "title": "Where the numbers come from",
      "items": [
        "The model fills a typed query spec; the server compiles it to SQL",
        "Results drop into slots; sentences reference slots, never digits",
        "Shapes: aggregate, list, lookup, absence; lookups answer up to 10 rows"
      ]
    },
    {
      "dot": "emerald",
      "title": "What makes it checkable",
      "items": [
        "Every answer is pinned to one checkpoint, so its citations stay provable",
        "Each cited record carries an RFC 9162 inclusion proof",
        "On the static site the same answers replay from a signed bundle"
      ]
    },
    {
      "dot": "rose",
      "title": "Refusals",
      "items": [
        "Forecasts, people, and anything outside the ledger are refused by reason",
        "An unknown filter value is refused and the real values are named",
        "In the full run no answer cited a record that failed verification"
      ]
    }
  ]
