    {
      "set": "smoke",
      "id": "S016",
      "question": "What does the FAR say about change orders in general?",
      "category": "policy",
      "answerable": true,
      "status": "answered",
      "refusal": null,
      "expected_refusal": null,
      "numeric_exact": null,
      "must": 1,
      "cited": 2,
      "cited_correct": 0,
      "cited_allowed": 0,
      "policy_section_ok": false,
      "quotes_faithful": false,
      "injection_ok": null,
      "fallback": false,
      "first_free_numbers": 5,
      "repaired": false,
      "integrity_ok": false,
      "tokens": 3142,
      "latency_ms": 15289,
      "composed": true,
      "sampled": false,
      "answer": "The FAR states that government contracts normally include a changes clause that allows the contracting officer to make unilateral changes within the general scope of the contract. These changes are made by issuing written change orders on Standard Form 30 (SF\u202f30), unless another method is provided. The contracting officer may also issue a change order electronically without an SF\u202f30 in unusual or urgent situations, as long as the message contains substantially the information required by the SF\u202f30 and immediate action is taken to issue the SF\u202f30. Change orders generally require documentation, and when they are not forward priced, both a change order and a supplemental agreement reflecting the equitable adjustment are needed, though a supplemental agreement alone may suffice if the adjustment can be agreed upon in advance.",
      "notes": [],
      "faithfulness": null
    },
