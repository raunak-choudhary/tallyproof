# The one public key this site trusts. Compiled into the build; never read from the bundle.
NEXT_PUBLIC_PINNED_VERIFIER_KEY=tallyproof.dev/log/v1+c04b910b+ARIXhwyOWRiBdf5kvkuHmZxGuibupdyNRDe40eDIu15y
# Where the signed replay bundle is served from.
NEXT_PUBLIC_REPLAY_BASE=/replay
# The live proof API, for the /live page. Leave empty for the static demo only.
# Live mode must pin the key that signs the live log (the dev key locally).
NEXT_PUBLIC_API_URL=
