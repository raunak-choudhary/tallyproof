# Tallyproof configuration. Copy to .env and adjust; .env is never committed.
# Every variable is described in docs/configuration.md.

# --- Data pipeline ---------------------------------------------------------
# Where downloads and Parquet output go. Ignored by git.
DATA_DIR=data
# Official USAspending.gov award data archive and API (no key needed).
DATA_SOURCE_USASPENDING_FILES_URL=https://files.usaspending.gov/award_data_archive/
DATA_SOURCE_USASPENDING_API_URL=https://api.usaspending.gov/api/v2/
# U.S. Treasury Fiscal Data API (no key needed).
DATA_SOURCE_FISCALDATA_API_URL=https://api.fiscaldata.treasury.gov/services/api/fiscal_service/
# Fiscal years to download, as a JSON list. [2024, 2025] is the full ~27 GB build.
DATA_FISCAL_YEARS=[2025]
# Download speed cap in megabytes per second.
DATA_DOWNLOAD_MAX_MBPS=20
# Seed for the injected, labeled anomalies. Same seed, same anomalies.
OVERLAY_SEED=42

# --- Spark resource limits (sized for an 8 GB laptop) ----------------------
SPARK_MASTER=local[3]
SPARK_DRIVER_MEMORY=2g
SPARK_SHUFFLE_PARTITIONS=16
