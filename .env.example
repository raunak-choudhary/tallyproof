# Tallyproof configuration. Copy to .env and adjust; .env is never committed.
# Every variable is described in docs/configuration.md.

# --- Data pipeline ---------------------------------------------------------
# Where downloads and Parquet output go. Ignored by git.
DATA_DIR=data
# Official USAspending.gov award data archive and API (no key needed).
DATA_SOURCE_USASPENDING_FILES_URL=https://files.usaspending.gov/award_data_archive/
DATA_SOURCE_USASPENDING_API_URL=https://api.usaspending.gov/api/v2/
# U.S. Treasury Fiscal Data API (no key needed).
DATA_SOURCE_FISCALDATA_API_URL=https://api.fiscaldata.treasury.gov/services/api/fiscal_service/
# eCFR versioner API for Federal Acquisition Regulation text (no key needed).
DATA_SOURCE_ECFR_API_URL=https://www.ecfr.gov/api/versioner/v1/
# Fiscal years to download, as a JSON list. [2024, 2025] is the full ~27 GB build.
DATA_FISCAL_YEARS=[2024, 2025]
# Account-level outlay data, one generated file per quarter. The replayed slice
# starts with the earliest transactions, so this matches the first fiscal year.
DATA_OUTLAY_FISCAL_YEAR=2024
DATA_OUTLAY_QUARTERS=[1]
# Download speed cap in megabytes per second.
DATA_DOWNLOAD_MAX_MBPS=20
# Seed for the injected, labeled anomalies. Same seed, same anomalies.
OVERLAY_SEED=42
# FAR parts kept in the policy corpus: definitions, reporting, financing and
# payments, and modifications.
POLICY_FAR_PARTS=[2, 4, 32, 43]

# --- Spark resource limits (sized for an 8 GB laptop) ----------------------
SPARK_MASTER=local[3]
SPARK_DRIVER_MEMORY=2g
SPARK_SHUFFLE_PARTITIONS=16

# --- API and workers -------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.local
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
# Both stay off for local HTTP; turn them on wherever the API is served over HTTPS.
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_HSTS_SECONDS=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
# The API refuses to start with anything other than public-no-pii.
DATA_CLASSIFICATION=public-no-pii

# --- Postgres (one role per job; see docs/configuration.md) ----------------
# Passwords the local container creates its roles with. Generate each one:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_SUPERUSER_PASSWORD=
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
DB_ANALYST_PASSWORD=
# Connection strings, using the passwords above:
#   postgres://tallyproof_app:PASSWORD@localhost:5432/tallyproof
DB_URL=
DB_OWNER_URL=
DB_ANALYST_URL=

# --- Streaming -------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:19092
KAFKA_TOPIC_EVENTS_RAW=fin.events.raw.v1
KAFKA_TOPIC_EVENTS_DLQ=fin.events.dlq.v1
KAFKA_CONSUMER_GROUP_INGEST=ingest-v1
INGEST_MAX_BATCH=500
DEDUPE_EXPECTED_ITEMS=1000000
DEDUPE_TARGET_FPR=0.001

# --- Merkle log and checkpoints --------------------------------------------
MERKLE_LOG_ORIGIN=dev.tallyproof.dev/log/v1
MERKLE_BATCH_MAX_SIZE=256
MERKLE_BATCH_MAX_AGE_MS=2000
# Printed by `make keygen KEY=dev`. The private key file is read only by the checkpointer.
CHECKPOINT_PUBLIC_KEY=
CHECKPOINT_SIGNING_KEY_FILE=secrets/checkpoint_dev.key
