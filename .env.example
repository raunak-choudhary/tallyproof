# Tallyproof configuration. Copy to .env and adjust; .env is never committed.
# Every variable is described in docs/configuration.md.

# --- Data pipeline ---------------------------------------------------------
# Where downloads and Parquet output go. Ignored by git.
DATA_DIR=data
# Official USAspending.gov award data archive and API (no key needed).
DATA_SOURCE_USASPENDING_FILES_URL=https://files.usaspending.gov/award_data_archive/
DATA_SOURCE_USASPENDING_API_URL=https://api.usaspending.gov/api/v2/
# U.S. Treasury Fiscal Data API (no key needed).
DATA_SOURCE_FISCALDATA_API_URL=https://api.fiscaldata.treasury.gov/services/api/fiscal_service/
# eCFR versioner API for Federal Acquisition Regulation text (no key needed).
DATA_SOURCE_ECFR_API_URL=https://www.ecfr.gov/api/versioner/v1/
# Fiscal years to download, as a JSON list. [2024, 2025] is the full ~27 GB build.
DATA_FISCAL_YEARS=[2024, 2025]
# Account-level outlay data, one generated file per quarter. The replayed slice
# starts with the earliest transactions, so this matches the first fiscal year.
DATA_OUTLAY_FISCAL_YEAR=2024
DATA_OUTLAY_QUARTERS=[1]
# Download speed cap in megabytes per second.
DATA_DOWNLOAD_MAX_MBPS=20
# Seed for the injected, labeled anomalies. Same seed, same anomalies.
OVERLAY_SEED=42
# FAR parts kept in the policy corpus: definitions, reporting, financing and
# payments, and modifications.
POLICY_FAR_PARTS=[2, 4, 32, 43]
# Where the committed FAR corpus lives.
POLICY_CORPUS_DIR=backend/corpus/far
# Build size: smoke, demo, full, or volume (sets events replayed and anomalies per type).
DATA_SCENARIO=full
# Uncomment only to override the scenario's sizes.
# DATA_REPLAY_SLICE_EVENTS=1000000
# OVERLAY_PER_ANOMALY=25
# Events per second when replaying gold into Kafka.
DATA_REPLAY_RATE_PER_SEC=2000
# How often the Treasury connector checks for a new daily statement.
DATA_TREASURY_POLL_SECONDS=3600

# --- Spark resource limits (sized for an 8 GB laptop) ----------------------
SPARK_MASTER=local[3]
SPARK_DRIVER_MEMORY=2g
SPARK_SHUFFLE_PARTITIONS=16

# --- API and workers -------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.local
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
# Both stay off for local HTTP; turn them on wherever the API is served over HTTPS.
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_HSTS_SECONDS=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
# The API refuses to start with anything other than public-no-pii.
DATA_CLASSIFICATION=public-no-pii
# Rate limits per client IP: read endpoints, and questions to the analyst.
API_THROTTLE_ANON_QUERIES=10/min
API_THROTTLE_ANON_READS=300/min
# Reverse proxies in front of the API, for finding the real client IP.
TRUSTED_PROXY_COUNT=0
# Where command-line tools such as make verify-event reach the API.
API_BASE_URL=http://127.0.0.1:8000
# DEBUG, INFO, WARNING, or ERROR; json for one object per line, console for reading.
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Postgres (one role per job; see docs/configuration.md) ----------------
# Passwords the local container creates its roles with. Generate each one:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_SUPERUSER_PASSWORD=
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
DB_ANALYST_PASSWORD=
# Connection strings, using the passwords above:
#   postgres://tallyproof_app:PASSWORD@localhost:5432/tallyproof
DB_URL=
DB_OWNER_URL=
DB_ANALYST_URL=
# Most records one answer may cite.
DB_ANALYST_MAX_ROWS=1000

# --- Streaming -------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:19092
KAFKA_TOPIC_EVENTS_RAW=fin.events.raw.v1
KAFKA_TOPIC_EVENTS_DLQ=fin.events.dlq.v1
KAFKA_CONSUMER_GROUP_INGEST=ingest-v1
INGEST_MAX_BATCH=500
DEDUPE_EXPECTED_ITEMS=1000000
DEDUPE_TARGET_FPR=0.001
KAFKA_SCHEMA_REGISTRY_URL=http://127.0.0.1:18081
KAFKA_TOPIC_LEDGER_APPENDED=ledger.appended.v1
KAFKA_TOPIC_CHECKPOINTS=ledger.checkpoints.v1
KAFKA_TOPIC_RECON_BREAKS=recon.breaks.v1

# --- Live updates (Redis channel layer and the WebSocket server) -----------
REDIS_URL=redis://127.0.0.1:6379/0
STREAM_HOST=127.0.0.1
STREAM_PORT=8001
# Per-IP connection cap, per-client buffer (oldest facts dropped past it), and
# the largest WebSocket frame the server accepts.
WS_MAX_CONNECTIONS_PER_IP=5
WS_CLIENT_BUFFER=100
WS_MAX_MESSAGE_BYTES=4096

# --- Reconciliation ---------------------------------------------------------
# Allowed difference before amounts count as mismatched, in dollars.
RECON_AMOUNT_TOLERANCE=0.00
# An event reported this long after it happened is a late arrival.
RECON_LATE_ARRIVAL_WATERMARK_HOURS=72

# --- Merkle log and checkpoints --------------------------------------------
MERKLE_LOG_ORIGIN=dev.tallyproof.dev/log/v1
MERKLE_BATCH_MAX_SIZE=256
MERKLE_BATCH_MAX_AGE_MS=2000
# Printed by `make keygen KEY=dev`. The private key file is read only by the checkpointer.
CHECKPOINT_PUBLIC_KEY=
CHECKPOINT_SIGNING_KEY_FILE=secrets/checkpoint_dev.key

# --- Witnesses and the tamper demo -------------------------------------------
WITNESS_EXPORT_PATH=var/witness/checkpoints.jsonl
# Longest gap before a checkpoint is timestamped externally (the level 4 window).
WITNESS_INTERVAL_SECONDS=3600
WITNESS_OTS_ENABLED=true
WITNESS_OTS_CALENDARS=https://a.pool.opentimestamps.org,https://b.pool.opentimestamps.org
# Only for the local tamper demo; it also refuses unless the database is on loopback.
DEMO_TAMPER_ENABLED=false

# --- Analyst model provider --------------------------------------------------
# fake answers from scripts and needs nothing. openai_compatible calls any
# provider that serves the OpenAI chat-completions protocol; the first one used
# is Google Gemini's free tier (key from https://aistudio.google.com/apikey).
LLM_PROVIDER=fake
# Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
LLM_BASE_URL=
# Secret. Never commit it, never paste it anywhere but .env.
LLM_API_KEY=
# Model IDs, read from the provider's console. Router and judge default to the answer model.
LLM_ANSWER_MODEL=
LLM_ROUTER_MODEL=
LLM_JUDGE_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
# Kept under the free tier's per-minute limit.
LLM_REQUESTS_PER_MINUTE=10
LLM_MAX_INPUT_TOKENS=8000
LLM_MAX_OUTPUT_TOKENS=1200
# Caps for one evaluation run; the run stops before a call would pass either.
LLM_RUN_MAX_REQUESTS=1500
LLM_RUN_MAX_TOKENS=3000000
# Recorded responses. Committed, so CI can replay them without a key.
LLM_CACHE_DIR=testdata/llm_cache
# Local embedding model for policy retrieval. Runs on the CPU; questions never leave the machine.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_CACHE_DIR=var/embeddings
